# Copy these into your Vercel project's Environment Variables (Settings -> Environment Variables).
# Never commit a real .env file — this one is just a template.

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

GOOGLE_SHEET_ID=1HDCf2UmVixRum1i7qS1k9NaOr--RBxqi7sBxRHsRq1o
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheet-writer@workshop-registrations-506509.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# --- Email OTP verification (used to auto-apply the IITR student discount) ---

# Any long random string. Used to HMAC-sign OTP tokens — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-a-long-random-string

# Gmail SMTP (via Nodemailer) — sends the OTP emails.
# GMAIL_USER: the sending Gmail address, e.g. aisecure6g.workshop@gmail.com
# GMAIL_APP_PASSWORD: a 16-character App Password for that account.
#   Requires 2-Step Verification to be enabled on the Gmail account, then
#   generate one under Google Account -> Security -> App Passwords.
GMAIL_USER=your-workshop-account@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- AI ID-card check (advisory only — never blocks registration) ---
# From console.anthropic.com -> Settings -> API Keys. Starts with sk-ant-.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx